# ==============================================================================
# BajkoKreator — Environment Configuration Example
# Copy to `.env.local` for local overrides. Never commit `.env` or `.env.local`.
# ==============================================================================

# Active AI provider adapter:
#   demo                — Instant Polish story + bundled painterly watercolor art (default, free, no key needed)
#   manual              — Full Polish script + English Character Bible prompts for Gemini / Nano Banana + manual uploads
#   gemini-api          — Google Gemini Developer API (@google/genai)
#   google-subscription — Prepared for Google AI Pro/Ultra external agent access (~2 Dec 2026)
AI_PROVIDER=demo

# Google Gemini Developer API (used when AI_PROVIDER=gemini-api)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Supported image models: gemini-nano-banana-2.1 | gemini-3-pro-image
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Hard daily server-side limit on billable AI image generations
MAX_DAILY_IMAGE_GENERATIONS=30

# Google AI Pro/Ultra Subscription Adapter (~2 December 2026 readiness)
# AuthStrategy: subscription_oauth_stub | api_key
GOOGLE_AI_AUTH_STRATEGY=subscription_oauth_stub
GOOGLE_SUBSCRIPTION_ENDPOINT=
GOOGLE_SUBSCRIPTION_TOKEN=
GOOGLE_SUBSCRIPTION_CLIENT_ID=
# Tier: ai-pro | ai-ultra
GOOGLE_SUBSCRIPTION_TIER=ai-pro

# Optional override for story & asset persistence root.
# Defaults to `./data` locally and automatically falls back to `/tmp/bajkokreator-data` on Vercel or read-only filesystems.
# BAJKOKREATOR_DATA_DIR=
